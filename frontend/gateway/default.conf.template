# Gateway: the single entry point. Everything the browser needs comes through here, from one origin:
#   /api/*   -> API replicas (per-request load balancing, rate limiting, 1 s microcache for reads)
#   /*       -> web (static Angular app), with an edge cache for the immutable bundles
#
# ${VARIABLES} are filled from the container environment at startup (see Dockerfile).

# Kubernetes DNS, taken from /etc/resolv.conf (NGINX_ENTRYPOINT_LOCAL_RESOLVERS). Names are re-resolved every
# 5 s, so API replicas added or removed by `kubectl scale` are picked up without restarting the gateway.
resolver ${NGINX_LOCAL_RESOLVERS} valid=5s ipv6=off;
resolver_timeout 2s;

# The API's headless Service returns one DNS record per ready pod; `resolve` keeps the list current and
# least_conn sends each request to the replica with the fewest in-flight requests.
upstream api {
  zone api 64k;
  least_conn;
  server ${API_UPSTREAM} resolve;
  keepalive 64;
}

upstream web {
  zone web 64k;
  server ${WEB_UPSTREAM} resolve;
  keepalive 16;
}

# Per-client-IP rate limit for the API (coarse protection in front of the API's own per-user limits).
limit_req_zone $binary_remote_addr zone=api_per_ip:10m rate=${GATEWAY_RATE_LIMIT_RPS}r/s;
limit_req_status 429;
limit_req_log_level warn;

# Edge cache for the web app's hashed static files.
proxy_cache_path /tmp/static-cache levels=1:2 keys_zone=static_cache:10m max_size=256m inactive=7d use_temp_path=off;

# Microcache for API reads (see location /api/).
proxy_cache_path /tmp/api-cache levels=1:2 keys_zone=api_cache:10m max_size=64m inactive=1m use_temp_path=off;

map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      '';
}

server {
  listen 8080;
  server_name _;

  client_max_body_size 1m;

  gzip on;
  gzip_comp_level 5;
  gzip_min_length 1024;
  gzip_proxied any;
  gzip_vary on;
  gzip_types text/css application/javascript application/json application/problem+json image/svg+xml;

  # Security headers for everything served through the gateway (see the snippet).
  include /etc/nginx/snippets/security-headers.conf;

  proxy_http_version 1.1;
  proxy_set_header Connection "";
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_set_header X-Forwarded-Host $host;
  proxy_set_header X-Forwarded-Port $server_port;
  proxy_connect_timeout 3s;
  proxy_read_timeout 30s;
  # A replica that fails or times out before sending a response is retried on another one (idempotent methods only).
  proxy_next_upstream error timeout http_502 http_503;
  proxy_next_upstream_tries 2;

  location = /healthz {
    access_log off;
    default_type text/plain;
    return 200 "ok\n";
  }

  # ^~ : this prefix match wins over the static-file regex below.
  location ^~ /api/ {
    limit_req zone=api_per_ip burst=${GATEWAY_RATE_LIMIT_BURST} nodelay;
    proxy_pass http://api;

    # Microcache for reads: identical GETs within 1 s are answered by nginx without reaching the API. This flattens
    # bursts (many dashboards polling, a refresh storm) while staying at most 1 s behind.
    #  - The key includes the Authorization header: a cached response is only ever reused for the same token, so a
    #    caller can never receive data it was not authorised to read, and requests without a token are never served
    #    from cache (they get 401 from the API, which is not cached).
    #  - Only 200 responses to GET/HEAD are stored; writes always reach the API.
    #  - A request with `Cache-Control: no-cache` (or `Pragma`) skips the cache: the web app sends it right after
    #    its own changes, so a user always sees the result of what they just did.
    #  - proxy_cache_lock collapses concurrent misses for the same key into a single upstream request.
    proxy_cache api_cache;
    proxy_cache_methods GET HEAD;
    proxy_cache_key "$request_method|$request_uri|$http_authorization";
    proxy_cache_valid 200 1s;
    proxy_cache_lock on;
    proxy_cache_lock_timeout 2s;
    proxy_cache_use_stale updating;
    proxy_cache_bypass $http_cache_control $http_pragma;
    add_header X-Cache-Status $upstream_cache_status always;
    include /etc/nginx/snippets/security-headers.conf;
  }

  # Hashed bundles: served from the edge cache after the first request.
  location ~* \.(?:js|css|woff2?|ico|svg|png)$ {
    proxy_pass http://web;
    proxy_cache static_cache;
    proxy_cache_valid 200 7d;
    proxy_cache_use_stale error timeout updating;
    proxy_cache_lock on;
    add_header X-Cache-Status $upstream_cache_status always;
    include /etc/nginx/snippets/security-headers.conf;
  }

  location / {
    proxy_pass http://web;
  }
}
