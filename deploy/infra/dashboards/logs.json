    {
      "id": 8,
      "type": "logs",
      "title": "Browser errors",
      "description": "What failed in users' browsers: the error, the route (query string removed), the user id (token subject; empty on the sign-in page), the browser and the release. Expand a line for the stack trace (minified bundle, line and column).",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 8,
        "h": 11
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{namespace=\"browser\"} | trace_id=~\"$trace_id.*\" |~ `(?i)${search:regex}` | json type=\"type\", value=\"value\", browser_version=\"browser_version\" | line_format `{{.type}}: {{.value}}  ·  {{.page}}  ·  user={{.user}}  ·  {{.browser}} {{.browser_version}}  ·  {{.app_version}}`",
