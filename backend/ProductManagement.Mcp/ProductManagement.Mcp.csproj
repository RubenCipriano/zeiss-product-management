<Project Sdk="Microsoft.NET.Sdk">

  <!--
    MCP (Model Context Protocol) server exposing the Product Management API as tools for AI assistants.
    Generated with `dotnet new mcpserver`; it is a client of the REST API, not of the database, so the
    API's authentication, RBAC and rate limits apply to every tool call.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RollForward>Major</RollForward>

    <!-- Packable as a .NET tool / MCP server package (as generated by the template). -->
    <PackAsTool>true</PackAsTool>
    <PackageType>McpServer</PackageType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageId>ProductManagement.Mcp</PackageId>
    <PackageVersion>1.0.0</PackageVersion>
    <PackageTags>AI; MCP; server; stdio; products; inventory</PackageTags>
    <Description>MCP server for the Product Management API: search products, inspect and adjust stock.</Description>
  </PropertyGroup>

  <ItemGroup>
    <None Include=".mcp\server.json" Pack="true" PackagePath="/.mcp/" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="ModelContextProtocol" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ProductManagement.Mcp.UnitTests" />
  </ItemGroup>

</Project>
