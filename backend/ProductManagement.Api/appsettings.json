{
  "ConnectionStrings": {
    "ProductManagement": "",
    "Redis": ""
  },
  "Cache": {
    "KeyPrefix": "product-management",
    "ProductTtl": "00:05:00",
    "ListTtl": "00:01:00"
  },
  "Database": {
    "ApplyMigrationsOnStartup": false,
    "SeedSampleData": false
  },
  "Authentication": {
    "Authority": "",
    "MetadataAddress": "",
    "Audience": "product-management-api",
    "RequireHttpsMetadata": true
  },
  "RateLimiting": {
    "Enabled": true,
    "RequestsPerSecond": 50,
    "RequestBurst": 100,
    "WritesPerSecond": 10,
    "WriteBurst": 20
  },
  "OpenApi": {
    "Enabled": false
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    },
    "Console": {
      "FormatterName": "json"
    }
  },
  "AllowedHosts": "*"
}
