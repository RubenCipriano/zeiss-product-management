{
  "ConnectionStrings": {
    "ProductManagement": "",
    "Redis": ""
  },
  "Cache": {
    "KeyPrefix": "product-management",
    "ProductTtl": "00:05:00",
    "ListTtl": "00:01:00"
  },
  "Database": {
    "ApplyMigrationsOnStartup": true,
    "SeedSampleData": false
  },
  "Authentication": {
    "Issuer": "product-management-api",
    "Audience": "product-management-api",
    "SigningKey": "",
    "AccessTokenLifetime": "01:00:00",
    "Consumers": []
  },
  "RateLimiting": {
    "Enabled": true,
    "RequestsPerSecond": 50,
    "RequestBurst": 100,
    "WritesPerSecond": 10,
    "WriteBurst": 20,
    "TokenRequestsPerMinute": 20
  },
  "OpenApi": {
    "Enabled": false
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.DataProtection": "Error",
      "Microsoft.EntityFrameworkCore": "Warning"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "UseUtcTimestamp": true,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ",
        "JsonWriterOptions": { "Indented": false }
      }
    }
  },
  "SignInThrottle": {
    "MaxFailures": 10,
    "Window": "00:01:00"
  },
  "Idempotency": {
    "KeyLifetime": "1.00:00:00",
    "InProgressTimeout": "00:01:00"
  }
}
