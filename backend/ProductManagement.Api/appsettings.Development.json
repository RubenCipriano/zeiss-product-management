{
  "ConnectionStrings": {
    "ProductManagement": "Host=localhost;Port=5432;Database=product_management;Username=product_management;Password=product_management",
    "Redis": ""
  },
  "Database": {
    "ApplyMigrationsOnStartup": true,
    "SeedSampleData": true
  },
  "Authentication": {
    "SigningKey": "(development key removed from history)",
    "Consumers": [
      {
        "ClientId": "viewer",
        "SecretHash": "pbkdf2-sha256$(development hash removed from history)",
        "Roles": [
          "viewer"
        ]
      },
      {
        "ClientId": "clerk",
        "SecretHash": "pbkdf2-sha256$(development hash removed from history)",
        "Roles": [
          "stock-clerk"
        ]
      },
      {
        "ClientId": "manager",
        "SecretHash": "pbkdf2-sha256$(development hash removed from history)",
        "Roles": [
          "manager"
        ]
      },
      {
        "ClientId": "mcp-server",
        "SecretHash": "pbkdf2-sha256$(development hash removed from history)",
        "Roles": [
          "stock-clerk"
        ]
      }
    ]
  },
  "OpenApi": {
    "Enabled": true
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    },
    "Console": {
      "FormatterName": "simple"
    }
  }
}
