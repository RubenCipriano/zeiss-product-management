{
  "ConnectionStrings": {
    "ProductManagement": "",
    "Redis": ""
  },
  "Cache": {
    "KeyPrefix": "product-management",
    "ProductTtl": "00:05:00",
    "ListTtl": "00:01:00"
  },
  "Database": {
    "ApplyMigrationsOnStartup": false,
    "SeedSampleData": false
  },
  "OpenApi": {
    "Enabled": false
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    },
    "Console": {
      "FormatterName": "json"
    }
  },
  "AllowedHosts": "*"
}
